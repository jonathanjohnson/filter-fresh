# Public — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://filterfresh.example.com

# Analytics (optional). When unset the scripts simply do not load and track() no-ops.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional). When unset the booking confirmation email is skipped.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Filter Fresh <bookings@filterfresh.example.com>"

# Twilio (optional). When any of these is unset the operator SMS is skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPERATOR_PHONE=
